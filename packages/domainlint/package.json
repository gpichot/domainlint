{
  "name": "domainlint",
  "description": "Linter for domain-based repository",
  "version": "0.9.1",
  "author": "Gabriel Pichot",
  "bin": {
    "domainlint": "./bin/run.js"
  },
  "bugs": "https://github.com/gpichot/domainlint/issues",
  "dependencies": {
    "@oclif/core": "^4.9.0",
    "@oclif/plugin-help": "^6.2.38",
    "chalk": "^5.6.2",
    "glob": "^13.0.6",
    "jsonc-parser": "^3.3.1",
    "minimatch": "^10.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.12",
    "@oclif/prettier-config": "^0.2.1",
    "@oclif/test": "^4.1.16",
    "@tanstack/intent": "^0.0.41",
    "@types/node": "^20",
    "@vitest/coverage-v8": "^4.1.0",
    "@vitest/ui": "^4.1.0",
    "memfs": "^4.56.11",
    "oclif": "^4.22.91",
    "shx": "^0.3.3",
    "ts-node": "^10",
    "typescript": "^5",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "./bin",
    "./dist",
    "./native/binding.cjs",
    "./native/binding.d.ts",
    "./oclif.manifest.json",
    "./schema.json",
    "skills"
  ],
  "homepage": "https://github.com/gpichot/domainlint",
  "keywords": [
    "oclif",
    "tanstack-intent"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "type": "module",
  "oclif": {
    "bin": "domainlint",
    "dirname": "domainlint",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help"
    ],
    "topicSeparator": " "
  },
  "repository": "gpichot/domainlint",
  "scripts": {
    "build": "shx rm -rf dist && tsc -b && node scripts/generate-schema.mjs",
    "prepack": "oclif manifest && oclif readme",
    "test": "node scripts/ensure-native.mjs && vitest",
    "test:run": "node scripts/ensure-native.mjs && vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "node scripts/ensure-native.mjs && vitest --coverage",
    "version": "oclif readme && git add README.md",
    "build:native": "napi build --platform --release --strip --manifest-path ../../crates/domainlint-graph-napi/Cargo.toml --output-dir native --commonjs --js binding.cjs --dts binding.d.ts --no-dts-header",
    "build:native:debug": "napi build --platform --manifest-path ../../crates/domainlint-graph-napi/Cargo.toml --output-dir native --commonjs --js binding.cjs --dts binding.d.ts --no-dts-header"
  },
  "types": "dist/index.d.ts",
  "napi": {
    "binaryName": "domainlint",
    "packageName": "domainlint-binding",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ]
  }
}

{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "packages": {
    "packages/domainlint": {
      "release-type": "node",
      "package-name": "domainlint",
      "extra-files": [
        {
          "type": "json",
          "path": "npm/darwin-arm64/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "package.json",
          "jsonpath": "$.optionalDependencies[\"domainlint-binding-darwin-arm64\"]"
        },
        {
          "type": "json",
          "path": "npm/darwin-x64/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "package.json",
          "jsonpath": "$.optionalDependencies[\"domainlint-binding-darwin-x64\"]"
        },
        {
          "type": "json",
          "path": "npm/linux-arm64-gnu/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "package.json",
          "jsonpath": "$.optionalDependencies[\"domainlint-binding-linux-arm64-gnu\"]"
        },
        {
          "type": "json",
          "path": "npm/linux-arm64-musl/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "package.json",
          "jsonpath": "$.optionalDependencies[\"domainlint-binding-linux-arm64-musl\"]"
        },
        {
          "type": "json",
          "path": "npm/linux-x64-gnu/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "package.json",
          "jsonpath": "$.optionalDependencies[\"domainlint-binding-linux-x64-gnu\"]"
        },
        {
          "type": "json",
          "path": "npm/linux-x64-musl/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "package.json",
          "jsonpath": "$.optionalDependencies[\"domainlint-binding-linux-x64-musl\"]"
        },
        {
          "type": "json",
          "path": "npm/win32-x64-msvc/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "package.json",
          "jsonpath": "$.optionalDependencies[\"domainlint-binding-win32-x64-msvc\"]"
        }
      ]
    }
  }
}

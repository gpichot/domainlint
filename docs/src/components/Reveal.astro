---
/**
 * Fades its children in when they scroll into view.
 * Renders a plain wrapper; the script is bundled once per page by Astro.
 */
interface Props {
  delay?: number;
  as?: 'div' | 'section';
  class?: string;
}
const { delay = 0, as: Tag = 'div', class: className = '' } = Astro.props;
---

<Tag class:list={['dl-reveal', className]} style={`--dl-delay:${delay}s`}>
  <slot />
</Tag>

<script>
  const els = document.querySelectorAll<HTMLElement>('.dl-reveal');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduce || !('IntersectionObserver' in window)) {
    for (const el of els) el.classList.add('is-visible');
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        }
      },
      { rootMargin: '0px 0px -10% 0px' },
    );
    for (const el of els) io.observe(el);
  }
</script>

---
/**
 * Tabbed bar chart of benchmark results. Numbers come from
 * `node benchmarks/run.mjs` (10,100-file fixture, median of 5 runs after a
 * warm-up). Update them when re-running.
 */
interface Row {
  tool: string;
  seconds: number;
}
interface Scenario {
  id: string;
  tab: string;
  caption: string;
  rows: Row[];
  note?: string;
}

const scenarios: Scenario[] = [
  {
    id: 'full',
    tab: 'Full CI check',
    caption: 'Cycles + feature boundaries in one run',
    rows: [
      { tool: 'domainlint', seconds: 0.3 },
      { tool: 'oxlint (no-cycle + boundaries JS plugin)', seconds: 3.55 },
      { tool: 'dependency-cruiser', seconds: 6.33 },
      { tool: 'ESLint (import-x + boundaries)', seconds: 15.81 },
    ],
    note: 'oxlint runs eslint-plugin-boundaries through its JS plugin API (alpha), with an element config you write. madge has no boundary rule.',
  },
  {
    id: 'boundaries',
    tab: 'Boundaries only',
    caption: 'Cross-feature imports must go through index.ts',
    rows: [
      { tool: 'domainlint', seconds: 0.24 },
      { tool: 'oxlint (boundaries JS plugin)', seconds: 2.64 },
      { tool: 'dependency-cruiser', seconds: 6.96 },
      { tool: 'ESLint (eslint-plugin-boundaries)', seconds: 13.67 },
    ],
  },
  {
    id: 'cycles',
    tab: 'Cycles only',
    caption: 'Import cycle detection',
    rows: [
      { tool: 'oxlint (import/no-cycle)', seconds: 0.26 },
      { tool: 'domainlint', seconds: 0.29 },
      { tool: 'dependency-cruiser', seconds: 5.43 },
      { tool: 'madge', seconds: 6.88 },
      { tool: 'ESLint (import-x/no-cycle)', seconds: 12.28 },
    ],
    note: 'domainlint and oxlint’s import/no-cycle are within noise of each other here. If cycles are all you need and you already run oxlint, turning on import/no-cycle is just as good.',
  },
];
---

<figure class="dl-bench">
  <div class="dl-bench-tabs" role="tablist" aria-label="Benchmark scenario">
    {
      scenarios.map((s, i) => (
        <button
          type="button"
          role="tab"
          id={`dl-tab-${s.id}`}
          aria-controls={`dl-panel-${s.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
        >
          {s.tab}
        </button>
      ))
    }
  </div>

  {
    scenarios.map((s, i) => {
      const max = Math.max(...s.rows.map((r) => r.seconds));
      const fastest = Math.min(...s.rows.map((r) => r.seconds));
      return (
        <div
          class="dl-bench-panel"
          role="tabpanel"
          id={`dl-panel-${s.id}`}
          aria-labelledby={`dl-tab-${s.id}`}
          hidden={i !== 0}
        >
          <div class="dl-bench-head">
            <strong>{s.caption}</strong>
            <span>10,100 TypeScript files · lower is better</span>
          </div>
          <ul>
            {s.rows.map((r, j) => (
              <li
                class:list={{ us: r.tool === 'domainlint', best: r.seconds === fastest }}
                style={`--w:${Math.max((r.seconds / max) * 100, 1.5)}%;--i:${j}`}
              >
                <span class="name">{r.tool}</span>
                <span class="track">
                  <span class="bar" />
                </span>
                <span class="val">
                  {r.seconds < 1 ? `${Math.round(r.seconds * 1000)}ms` : `${r.seconds.toFixed(1)}s`}
                  {r.seconds !== fastest && <small>{(r.seconds / fastest).toFixed(1)}× slower</small>}
                </span>
              </li>
            ))}
          </ul>
          {s.note && <p class="dl-bench-note">{s.note}</p>}
        </div>
      );
    })
  }

  <p class="dl-bench-foot">
    Synthetic project, Node 22, 4 vCPU Linux. Median of 5 runs after warm-up, including process
    start-up. On ~500 files every tool finishes in about a second.
    <a href="https://github.com/gpichot/domainlint/tree/main/benchmarks">Reproduce it yourself →</a>
  </p>
</figure>

<style>
  .dl-bench {
    margin: 0;
    padding: clamp(1rem, 3vw, 1.75rem);
    border-radius: 18px;
    border: 1px solid var(--dl-border);
    background: var(--dl-card-bg);
  }
  .dl-bench-tabs {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    padding: 0.25rem;
    border-radius: 999px;
    border: 1px solid var(--dl-border);
    margin-bottom: 1.25rem;
  }
  .dl-bench-tabs button {
    all: unset;
    cursor: pointer;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    color: var(--sl-color-gray-2);
    transition: background 0.2s, color 0.2s;
  }
  .dl-bench-tabs button[aria-selected='true'] {
    background: var(--sl-color-accent);
    color: var(--sl-color-white);
  }
  :global([data-theme='light']) .dl-bench-tabs button[aria-selected='true'] {
    color: #fff;
  }
  .dl-bench-tabs button:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  .dl-bench-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
    margin-bottom: 1.1rem;
  }
  .dl-bench-head strong { color: var(--sl-color-white); }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.9rem;
  }
  li {
    display: grid;
    grid-template-columns: minmax(7rem, 15rem) 1fr 5.5rem;
    align-items: center;
    gap: 0.9rem;
    margin: 0 !important;
  }
  .name {
    font-weight: 600;
    font-size: var(--sl-text-sm);
    line-height: 1.25;
    color: var(--sl-color-white);
  }
  small {
    display: block;
    font-weight: 400;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .track {
    height: 0.9rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--sl-color-gray-5) 35%, transparent);
    overflow: hidden;
  }
  .bar {
    display: block;
    height: 100%;
    width: var(--w);
    border-radius: inherit;
    background: var(--sl-color-gray-4);
    transform-origin: left;
    transform: scaleX(0);
  }
  .best .bar { background: rgb(34 197 94); }
  .us .bar {
    background: var(--dl-grad);
    box-shadow: 0 0 18px rgb(124 92 255 / 0.6);
  }
  .val {
    font-family: var(--sl-font-mono);
    font-weight: 700;
    font-size: var(--sl-text-sm);
    text-align: end;
    color: var(--sl-color-white);
  }
  .best .val { color: var(--dl-ok); }
  :global(.is-visible) .dl-bench-panel:not([hidden]) .bar {
    animation: grow 1.1s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    animation-delay: calc(var(--i) * 0.12s + 0.15s);
  }
  @keyframes grow { to { transform: scaleX(1); } }
  .dl-bench-note {
    margin: 1rem 0 0 !important;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
    border-inline-start: 3px solid var(--sl-color-accent);
    padding-inline-start: 0.75rem;
  }
  .dl-bench-foot {
    margin: 1.2rem 0 0 !important;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  @media (max-width: 40rem) {
    li { grid-template-columns: 1fr auto; }
    .track { grid-column: 1 / -1; grid-row: 2; }
  }
  @media (prefers-reduced-motion: reduce) {
    .bar { transform: none; animation: none !important; }
  }
</style>

<script>
  for (const fig of document.querySelectorAll<HTMLElement>('.dl-bench')) {
    const tabs = [...fig.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement) => {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = fig.querySelector<HTMLElement>(`#${t.getAttribute('aria-controls')}`);
        if (panel) panel.hidden = !on;
      }
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!d) return;
        const next = tabs[(i + d + tabs.length) % tabs.length];
        select(next);
        next.focus();
      });
    });
  }
</script>

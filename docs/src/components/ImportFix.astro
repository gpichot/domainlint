---
/**
 * Looping before/after animation: a deep cross-feature import gets rewritten
 * to go through the feature's barrel. Reduced motion shows the "after" state.
 */
---

<figure class="dl-fix" aria-label="A deep import rewritten to use the feature barrel">
  <div class="dl-fix-file">src/features/checkout/pay.ts</div>
  <pre><code><span class="kw">import</span> {'{'} computeTax {'}'} <span class="kw">from</span> <span class="str">'@/features/billing<span class="deep">/internal/tax</span>'</span>;<span class="mark mark-err" aria-hidden="true">✗ noCrossFeatureDeepImport</span><span class="mark mark-ok" aria-hidden="true">✓ via barrel</span></code></pre>
  <div class="dl-fix-file">src/features/billing/index.ts</div>
  <pre><code><span class="kw">export</span> {'{'} computeTax {'}'} <span class="kw">from</span> <span class="str">'./internal/tax'</span>;<span class="added" aria-hidden="true">  // added to the public API</span></code></pre>
</figure>

<style>
  .dl-fix {
    margin: 1rem 0;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--dl-border);
    background: #0d0b16;
  }
  .dl-fix-file {
    font-family: var(--sl-font-mono);
    font-size: 0.72rem;
    color: #8b85a0;
    padding: 0.45rem 1rem;
    background: #16131f;
    border-bottom: 1px solid rgb(255 255 255 / 0.06);
  }
  pre {
    margin: 0 !important;
    padding: 0.9rem 1rem !important;
    background: transparent !important;
    border: 0 !important;
    color: #e6e1f5;
    font-size: clamp(0.72rem, 1.6vw, 0.85rem);
    overflow-x: auto;
  }
  code { background: none !important; color: inherit; padding: 0; }
  .kw { color: #c4a7ff; }
  .str { color: #a5f3c4; }
  .deep {
    display: inline-block;
    color: #fb7185;
    text-decoration: wavy underline #fb7185;
    text-underline-offset: 4px;
    white-space: pre;
    vertical-align: bottom;
    overflow: hidden;
    max-width: 14ch;
    animation: dl-remove 6s ease-in-out infinite;
  }
  .mark {
    margin-inline-start: 1rem;
    font-family: var(--sl-font);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
  }
  .mark-err {
    color: #fb7185;
    background: rgb(244 63 94 / 0.15);
    animation: dl-err 6s ease-in-out infinite;
  }
  .mark-ok {
    display: none;
    color: #4ade80;
    background: rgb(34 197 94 / 0.15);
    animation: dl-ok 6s ease-in-out infinite;
  }
  .added {
    color: #8b85a0;
    animation: dl-fade 6s ease-in-out infinite;
  }

  /* 0–35%: broken. 35–50%: path collapses. 50–95%: fixed. */
  @keyframes dl-remove {
    0%, 35% { max-width: 14ch; opacity: 1; }
    50%, 95% { max-width: 0; opacity: 0; }
    100% { max-width: 14ch; opacity: 1; }
  }
  @keyframes dl-err {
    0%, 35% { display: inline; opacity: 1; }
    45%, 100% { display: none; opacity: 0; }
  }
  @keyframes dl-ok {
    0%, 48% { display: none; opacity: 0; }
    55%, 95% { display: inline; opacity: 1; }
    100% { display: none; opacity: 0; }
  }
  @keyframes dl-fade {
    0%, 45% { opacity: 0.15; }
    55%, 95% { opacity: 1; }
    100% { opacity: 0.15; }
  }

  @media (prefers-reduced-motion: reduce) {
    .deep, .mark-err { display: none; animation: none; }
    .mark-ok { display: inline; animation: none; }
    .added { animation: none; }
  }
</style>

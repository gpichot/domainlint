---
/**
 * Animated diagram of the two built-in rules: barrel-only cross-feature
 * imports, and import cycle detection. Animation starts on scroll into view.
 */
---

<figure class="dl-diagram" data-diagram>
  <svg viewBox="0 0 760 300" role="img" aria-labelledby="dl-diagram-title dl-diagram-desc">
    <title id="dl-diagram-title">How domainlint sees your features</title>
    <desc id="dl-diagram-desc">
      The checkout feature imports billing through its index.ts barrel, which is allowed. A
      direct import of billing/tax.ts is blocked. Inside billing, invoice.ts and tax.ts import
      each other, which is reported as a cycle.
    </desc>
    <defs>
      <marker id="dl-arrow-ok" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" class="fill-ok"></path>
      </marker>
      <marker id="dl-arrow-err" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" class="fill-err"></path>
      </marker>
    </defs>

    <!-- Feature: checkout -->
    <g class="feat">
      <rect x="20" y="30" width="260" height="240" rx="16" class="feat-box"></rect>
      <text x="40" y="58" class="feat-label">features/checkout</text>
      <rect x="45" y="75" width="210" height="40" rx="8" class="file barrel"></rect>
      <text x="60" y="100" class="file-label">index.ts <tspan class="tag">barrel</tspan></text>
      <rect x="45" y="140" width="210" height="40" rx="8" class="file"></rect>
      <text x="60" y="165" class="file-label">cart.ts</text>
      <rect x="45" y="205" width="210" height="40" rx="8" class="file"></rect>
      <text x="60" y="230" class="file-label">pay.ts</text>
    </g>

    <!-- Feature: billing -->
    <g class="feat">
      <rect x="440" y="30" width="260" height="240" rx="16" class="feat-box billing-box"></rect>
      <text x="460" y="58" class="feat-label">features/billing</text>
      <rect x="465" y="75" width="210" height="40" rx="8" class="file barrel barrel-target"></rect>
      <text x="480" y="100" class="file-label">index.ts <tspan class="tag">barrel</tspan></text>
      <rect x="465" y="140" width="210" height="40" rx="8" class="file cyc-node"></rect>
      <text x="480" y="165" class="file-label">invoice.ts</text>
      <rect x="465" y="205" width="210" height="40" rx="8" class="file cyc-node deep-target"></rect>
      <text x="480" y="230" class="file-label">tax.ts</text>
    </g>

    <!-- 1. allowed: through the barrel -->
    <path d="M255 160 C 360 160, 360 95, 462 95" class="edge edge-ok" marker-end="url(#dl-arrow-ok)"></path>
    <g class="badge badge-ok">
      <rect x="305" y="52" width="104" height="24" rx="12"></rect>
      <text x="357" y="68">✓ via barrel</text>
    </g>

    <!-- 2. blocked: deep import -->
    <path d="M255 225 L 428 225" class="edge edge-err" marker-end="url(#dl-arrow-err)"></path>
    <g class="stop">
      <line x1="432" y1="210" x2="432" y2="240"></line>
    </g>
    <g class="badge badge-err">
      <rect x="282" y="240" width="140" height="24" rx="12"></rect>
      <text x="352" y="256">✗ deep import</text>
    </g>

    <!-- 3. cycle inside billing -->
    <path d="M677 152 C 735 152, 735 228, 677 228" class="edge edge-cyc" marker-end="url(#dl-arrow-err)"></path>
    <path d="M677 214 C 712 214, 712 166, 677 166" class="edge edge-cyc edge-cyc-2" marker-end="url(#dl-arrow-err)"></path>
    <g class="badge badge-cyc">
      <rect x="690" y="178" width="64" height="24" rx="12"></rect>
      <text x="722" y="194">cycle</text>
    </g>
  </svg>
  <figcaption>
    <span><b class="c-ok">✓</b> Cross-feature imports go through the barrel</span>
    <span><b class="c-err">✗</b> Reaching into another feature's internals</span>
    <span><b class="c-err">↻</b> Modules that import each other</span>
  </figcaption>
</figure>

<style>
  .dl-diagram {
    margin: 0;
    padding: clamp(0.75rem, 2vw, 1.5rem);
    border-radius: 18px;
    border: 1px solid var(--dl-border);
    background:
      radial-gradient(70% 90% at 50% 0%, rgb(124 92 255 / 0.12), transparent 70%),
      var(--dl-card-bg);
  }
  svg {
    width: 100%;
    height: auto;
    display: block;
    font-family: var(--sl-font-mono);
  }
  .feat-box {
    fill: color-mix(in srgb, var(--sl-color-gray-6) 60%, transparent);
    stroke: var(--dl-border);
    stroke-width: 1.5;
  }
  .feat-label {
    font-size: 13px;
    font-weight: 700;
    fill: var(--sl-color-gray-2);
  }
  /* Plain rgb (not color-mix) so stroke can animate cleanly in Chromium. */
  .file {
    fill: var(--sl-color-bg);
    stroke: rgb(140 140 160 / 0.5);
    stroke-width: 1.5;
    transition: stroke 0.4s, fill 0.4s;
  }
  .file.barrel {
    stroke: rgb(124 92 255 / 0.75);
  }
  .file-label {
    font-size: 13px;
    fill: var(--sl-color-white);
  }
  .tag {
    font-size: 10px;
    fill: var(--sl-color-accent-high);
  }
  .fill-ok { fill: var(--dl-ok); }
  .fill-err { fill: var(--dl-err); }

  .edge {
    fill: none;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 400;
    stroke-dashoffset: 400;
  }
  .edge-ok { stroke: var(--dl-ok); }
  .edge-err, .edge-cyc { stroke: var(--dl-err); }

  .badge rect { stroke-width: 1.2; }
  .badge text {
    font-size: 12px;
    font-weight: 700;
    text-anchor: middle;
    font-family: var(--sl-font);
  }
  .badge-ok rect { fill: color-mix(in srgb, var(--dl-ok) 18%, var(--sl-color-bg)); stroke: var(--dl-ok); }
  .badge-ok text { fill: var(--dl-ok); }
  .badge-err rect, .badge-cyc rect { fill: color-mix(in srgb, var(--dl-err) 18%, var(--sl-color-bg)); stroke: var(--dl-err); }
  .badge-err text, .badge-cyc text { fill: var(--dl-err); }
  .badge, .stop { opacity: 0; }
  .stop line { stroke: var(--dl-err); stroke-width: 5; stroke-linecap: round; }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: center;
    margin-top: 0.75rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
  .c-ok { color: var(--dl-ok); }
  .c-err { color: var(--dl-err); }

  /* ---- timeline (runs once visible, then loops the flow) ---- */
  :global(.is-visible) .edge-ok {
    animation: draw 0.9s 0.3s ease-out forwards, flow 1.2s 1.4s linear infinite;
  }
  :global(.is-visible) .badge-ok { animation: pop 0.4s 1.1s ease-out forwards; }
  :global(.is-visible) .barrel-target { animation: glow-ok 0.8s 1.1s ease-out forwards; }

  :global(.is-visible) .edge-err { animation: draw-stop 0.8s 1.8s ease-in forwards; }
  :global(.is-visible) .stop { animation: pop 0.25s 2.5s ease-out forwards, shake 0.4s 2.55s ease-in-out; }
  :global(.is-visible) .badge-err { animation: pop 0.4s 2.7s ease-out forwards; }

  :global(.is-visible) .edge-cyc { animation: draw 0.8s 3.4s ease-out forwards, flow 1.2s 4.3s linear infinite; }
  :global(.is-visible) .edge-cyc-2 { animation-delay: 3.9s, 4.8s; }
  :global(.is-visible) .badge-cyc { animation: pop 0.4s 4.6s ease-out forwards, pulse 1.6s 5s ease-in-out infinite; }
  :global(.is-visible) .cyc-node { animation: glow-err 0.8s 4.4s ease-out forwards; }

  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes draw-stop { to { stroke-dashoffset: 0; } }
  @keyframes flow {
    from { stroke-dasharray: 8 8; stroke-dashoffset: 32; }
    to { stroke-dasharray: 8 8; stroke-dashoffset: 0; }
  }
  @keyframes pop {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes shake {
    25% { transform: translateX(-3px); }
    75% { transform: translateX(3px); }
  }
  @keyframes pulse { 50% { opacity: 0.55; } }
  @keyframes glow-ok { to { stroke: rgb(34 197 94); fill: rgb(34 197 94 / 0.1); } }
  @keyframes glow-err { to { stroke: rgb(244 63 94); fill: rgb(244 63 94 / 0.08); } }

  @media (prefers-reduced-motion: reduce) {
    .edge { stroke-dashoffset: 0; animation: none !important; }
    .badge, .stop { opacity: 1; animation: none !important; }
    .cyc-node { stroke: var(--dl-err); }
    .barrel-target { stroke: var(--dl-ok); }
  }
</style>

{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 80,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "sortPackageJson": false,
  "experimentalSortImports": { "newlinesBetween": false },
  "ignorePatterns": [
    "**/node_modules",
    "**/dist",
    "**/build",
    "**/coverage",
    "docs/.astro",
    "benchmarks/.tools",
    "benchmarks/.fixtures",
    "pnpm-lock.yaml",
    "**/*.md",
    "**/*.mdx",
    "**/*.toml",
    "**/*.yaml",
    "**/*.yml"
  ]
}
